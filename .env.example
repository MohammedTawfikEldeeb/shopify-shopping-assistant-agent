# App settings (used by src/config.py)
# For Supabase: use host, port (6543 for PgBouncer), database, user, password, sslmode
# Find these in Supabase Dashboard → Project Settings → Database → Connection string (PgBouncer)
POSTGRES__HOST=aws-0-eu-west-1.pooler.supabase.com
POSTGRES__PORT=6543
POSTGRES__DATABASE=postgres
POSTGRES__USER=postgres.<your-project-ref>
POSTGRES__PASSWORD=change_me
POSTGRES__SSLMODE=require

# Qdrant Configuration - Switch between local and cloud
# QDRANT__ENVIRONMENT: 'local' or 'cloud' (default: 'local')
QDRANT__ENVIRONMENT=local

# Local Configuration (used when QDRANT__ENVIRONMENT=local)
QDRANT__HOST=localhost
QDRANT__PORT=6333

# Cloud Configuration (used when QDRANT__ENVIRONMENT=cloud)
# Uncomment and fill these when QDRANT__ENVIRONMENT=cloud
# QDRANT__URL=https://xxx-xxx.qdrant.io
# QDRANT__API_KEY=your-api-key-here

# Collection name (same for both local and cloud)
QDRANT__COLLECTION_NAME=products

# LLM Configuration
LLM__PROVIDER=groq
LLM_MODEL__NAME=openai/gpt-oss-120b
GROQ_API__KEY=your-groq-key-here
GROQ_API__BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API__KEY=your-openrouter-key-here
OPENROUTER_API__BASE_URL=https://openrouter.ai/api/v1

# Docker Postgres bootstrap vars (required by postgres image)
POSTGRES_DB=shopify_assistant
POSTGRES_USER=shopify_user
POSTGRES_PASSWORD=change_me
