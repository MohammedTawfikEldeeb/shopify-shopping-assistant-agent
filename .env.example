# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# For Supabase: use host, port (6543 for PgBouncer), database, user, password
# Find these in Supabase Dashboard → Project Settings → Database → Connection string (PgBouncer)
# For AWS RDS: find these in RDS Console → Databases → your instance → Connectivity
POSTGRES__HOST=aws-0-eu-west-1.pooler.supabase.com
POSTGRES__PORT=6543
POSTGRES__DATABASE=postgres
POSTGRES__USER=postgres.<your-project-ref>
POSTGRES__PASSWORD=your-supabase-password
POSTGRES__SSLMODE=require

# =============================================================================
# Vector DB
# =============================================================================
VECTOR_DB_PROVIDER=PGVECTOR

# =============================================================================
# Qdrant (optional — only if using Qdrant instead of PGVector)
# =============================================================================
QDRANT__ENVIRONMENT=local
QDRANT__HOST=localhost
QDRANT__PORT=6333
QDRANT__URL=
QDRANT__API_KEY=
QDRANT__COLLECTION_NAME=products

# =============================================================================
# LLM
# =============================================================================
LLM__PROVIDER=openrouter
LLM_MODEL__NAME=openai/gpt-oss-20b:nitro
OPENROUTER_API__KEY=your-openrouter-key-here
GROQ_API__KEY=your-groq-key-here

# =============================================================================
# Observability
# =============================================================================
OPIK__API_KEY=your-opik-key-here
OPIK__PROJECT_NAME=shopify-shopping-assistant-agent

# =============================================================================
# Search
# =============================================================================
SEARCH__USE_HYBRID_SEARCH=true

# =============================================================================
# CORS (comma-separated list of allowed origins)
# =============================================================================
# Local dev:
# CORS__ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Production (Vercel frontend + your domain):
# CORS__ALLOWED_ORIGINS=["https://your-app.vercel.app"]
CORS__ALLOWED_ORIGINS=["*"]

# =============================================================================
# Docker Postgres bootstrap vars (local dev only)
# =============================================================================
POSTGRES_DB=shopify_assistant
POSTGRES_USER=shopify_user
POSTGRES_PASSWORD=change_me
